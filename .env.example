# ─── LLM Provider API Keys ───────────────────────────────────────────

# Anthropic (Claude models)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
# GEMINI_API_KEY=AIza...
# GOOGLE_API_KEY=AIza...          # Alternative to GEMINI_API_KEY

# OpenAI
# OPENAI_API_KEY=sk-...

# Groq (fast inference)
# GROQ_API_KEY=gsk_...

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# OpenRouter (multi-provider gateway)
# OPENROUTER_API_KEY=sk-or-...

# Together AI
# TOGETHER_API_KEY=...

# Mistral AI
# MISTRAL_API_KEY=...

# Novita AI (multi-model gateway)
# NOVITA_API_KEY=...

# Kilo AI (multi-provider gateway)
# KILO_API_KEY=...

# Cline AI
# CLINE_API_KEY=...

# Z.ai provider
# ZAI_API_KEY=...

# Nvidia NIM (multi-provider gateway)
# NVIDIA_API_KEY=...

# ─── Local LLM Providers (no API key needed) ─────────────────────────

# Ollama (default: http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# vLLM (default: http://localhost:8000)
# VLLM_BASE_URL=http://localhost:8000

# LM Studio (default: http://localhost:1234)
# LMSTUDIO_BASE_URL=http://localhost:1234

# ── Optional integrations (Web Search) ──────────────────
#
# Web search (Brave / SearXNG) — read by the web-search tool, not config:

# BRAVE_API_KEY=your-brave-search-api-key

# SEARXNG_INSTANCE_URL=https://searx.example.com

# TAVILY_API_KEY=your-brave-search-api-key
